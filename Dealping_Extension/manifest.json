{
  "manifest_version": 3,
  "name": "DealPing Radar & Auto Worker v3.1",
  "version": "3.1.0",
  "description": "Cầu nối ngầm & Máy trạm Auto Worker tự động bắt Giá Sau Voucher trên Shopee & TikTok Shop cho DealPing.",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://*.shopee.vn/*",
    "*://*.tiktok.com/*",
    "*://dealpingapp.com/*",
    "*://*.dealpingapp.com/*",
    "*://localhost/*",
    "*://127.0.0.1/*",
    "*://*.onrender.com/*",
    "*://*.vercel.app/*",
    "*://*.netlify.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DealPing Bridge & Worker",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.shopee.vn/*",
        "*://*.tiktok.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://dealpingapp.com/*",
        "*://*.dealpingapp.com/*",
        "*://localhost/*",
        "*://127.0.0.1/*",
        "*://*.vercel.app/*",
        "*://*.netlify.app/*"
      ],
      "js": [
        "webapp_bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://dealpingapp.com/*",
        "*://*.dealpingapp.com/*",
        "*://localhost/*",
        "*://127.0.0.1/*",
        "*://*.vercel.app/*",
        "*://*.netlify.app/*"
      ],
      "js": [
        "page_interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
